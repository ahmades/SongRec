msgid "Audio error:"
msgstr "Erreur audio :"

#: src/core/microphone_thread.rs:159 src/core/microphone_thread.rs:164
msgid "Audio error: No input device available"
msgstr "Erreur audio : pas de périphérique d'entrée disponible"

